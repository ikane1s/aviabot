# Never commit real tokens. Keep them only in the local .env or host secret store.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_TARGET_CHAT_ID=
# Optional. Production uses the local SSH SOCKS tunnel for Telegram only.
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TRAVELPAYOUTS_API_TOKEN=

APP_TIMEZONE=Asia/Novosibirsk
DATABASE_PATH=data/flight_price_bot.db
HEADLESS_BROWSER=false
LIVE_PAIRS_PER_CYCLE=3
CHECK_INTERVAL_MINUTES=120
DAILY_SUMMARY_HOUR=10

SPECTACULAR_PRICE_RUB=20000
EXCELLENT_PRICE_RUB=25000
GOOD_PRICE_RUB=30000
MAXIMUM_PRICE_RUB=35000

PREFERRED_TRIP_DAYS=5
MINIMUM_TRIP_DAYS=4
MAXIMUM_TRIP_DAYS=7
